<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Crypto Shift notification icon
        Mimics the app logo: thick C ring + upward-right arrow through the gap

        C ring: center (12,12), outer radius 9, inner radius 6.5
        Gap is on the right side, between angles -45° and +45° from x-axis
          Outer gap points: (18.4, 5.6) upper-right and (18.4, 18.4) lower-right
          Inner gap points: (16.6, 7.4) upper-right and (16.6, 16.6) lower-right
        Path goes: outer arc CCW (sweep=0, large-arc=1) around left side of C,
                   line to inner lower-right gap,
                   inner arc CW (sweep=1, large-arc=1) back through left side,
                   closes to outer upper-right gap.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.4,5.6 A9,9 0 1,0 18.4,18.4 L16.6,16.6 A6.5,6.5 0 1,1 16.6,7.4 Z"/>

    <!--
        Arrow: diagonal line going from inside the C (lower-left) up through the gap
        Body: thick parallelogram from (8,16) to (15.5,8.5)
        Arrowhead: triangle pointing upper-right toward (19.5,4.5)
    -->
    <!-- Arrow body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.5,15.5 L8.5,16.5 L16.0,9.0 L15.0,8.0 Z"/>

    <!-- Arrowhead -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M19.5,4.5 L16.0,9.4 L14.0,7.6 Z"/>

</vector>
